# 复制为 .env 后按需修改
NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=6687
DB_USER=your-db-user
DB_PASSWORD=replace-before-use
DB_NAME=luckygo
DB_SSL=false
DB_CONNECTION_LIMIT=10

ADMIN_JWT_SECRET=replace-with-a-long-random-secret
SUPER_ADMIN_PHONE=replace-before-use
SUPER_ADMIN_PASSWORD=replace-before-production

# H5 验证码：POST /api/auth/otp/request、/api/auth/otp/verify
# 本地建议 SMS_GHANA_ENABLED=false（Sundex 白名单），用 H5_OTP_DEV_CODE=888888 登录
# 生产服务器填写 KEY/SECRET 并 SMS_GHANA_ENABLED=true
SMS_GHANA_ENABLED=false
SMS_GHANA_APP_URL=https://api.sundexcloudsms.com/api/v1/messages/send
SMS_GHANA_KEY=
SMS_GHANA_SECRET=
SMS_GHANA_PREFIX=[Eba phones]
SMS_GHANA_TEMPLATE_LOGIN_BODY=Your verification code is {:code}, valid for 5 minutes
SMS_GHANA_TEMPLATE_MARKETING_BODY=
SMS_GHANA_CODE_TTL=300
SMS_GHANA_COOLDOWN_TTL=60
SMS_GHANA_WINDOW_TTL=300
SMS_GHANA_MAX_REQUESTS=5
H5_OTP_DEV_CODE=888888
H5_OTP_DEV_BYPASS_ENABLED=true
H5_OTP_RETURN_CODE=false

# 管理端：POST /api/auth/login（手机号 + 密码）

LOG_DIR=logs
# logs/auto-draw/日期.log、logs/hubtel-payment-callback/日期.log、logs/h5/日期.log；时间 YYYY-MM-DD HH:mm:ss.SSS
LOG_TZ=Africa/Accra
TID_HEADER_NAME=X-Trace-Id

# Hubtel 正式环境（与 .env.production.example 一致，本地调试走真实支付接口）
HUBTEL_MODE=production
HUBTEL_ACCOUNT_NUMBER=replace-before-use
HUBTEL_API_ID=replace-before-use
HUBTEL_API_KEY=replace-before-use
HUBTEL_CALLBACK_URL=https://your-api-host.example/api/payments/hubtel/callback
HUBTEL_WALLET_RETURN_URL=http://localhost:5174/wallet/pay/return
# HUBTEL_REFUND_CALLBACK_URL=https://api.luckygo.kwikcc.com/api/payments/hubtel/refund-callback

# 阿里云 OSS（管理端 / H5 图片上传）
OSS_ACCESS_ID=
OSS_ACCESS_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=oss-cn-hongkong.aliyuncs.com
OSS_PUBLIC_URL=https://your-bucket.oss-cn-hongkong.aliyuncs.com

# 满员自动开奖：Redis + BullMQ 延迟队列（秒级准时，运营必开）
# 本机连宝塔：REDIS_HOST=服务器公网IP；同机部署：127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
AUTO_DRAW_REDIS_ENABLED=true
# 每分钟同步 Redis 任务 + 兜底扫库（Redis 短暂故障时）
AUTO_DRAW_RECOVERY_ENABLED=true
