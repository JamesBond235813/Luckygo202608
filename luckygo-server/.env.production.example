# EBA Promo — 复制到服务器 luckygo-server 目录后改名为 .env（与 dist、package.json 同目录）
# API：https://api.luckygo.kwikcc.com

NODE_ENV=production
PORT=3000

# 满员自动开奖：Redis 延迟队列（宝塔 Redis 7，本机 127.0.0.1）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
AUTO_DRAW_REDIS_ENABLED=true
AUTO_DRAW_RECOVERY_ENABLED=true

# 阿里云 RDS（深圳，端口 6687）
DB_HOST=your-production-db-host
DB_PORT=6687
DB_USER=your-production-db-user
DB_PASSWORD=replace-before-use
DB_NAME=luckygo
DB_SSL=false
DB_CONNECTION_LIMIT=20
DB_TIMEZONE=+08:00

# 管理端 JWT + 超管（H5 验证码登录不走此账号）
ADMIN_JWT_SECRET=replace-with-a-long-random-secret
SUPER_ADMIN_PHONE=replace-before-use
SUPER_ADMIN_PASSWORD=replace-before-use

# H5 验证码：Sundex 加纳短信（与 PHP config/sms.php 一致）
SMS_GHANA_ENABLED=true
SMS_GHANA_APP_URL=https://api.sundexcloudsms.com/api/v1/messages/send
SMS_GHANA_KEY=replace-before-use
SMS_GHANA_SECRET=replace-before-use
SMS_GHANA_PREFIX=[Eba phones]
SMS_GHANA_TEMPLATE_LOGIN_BODY=Your verification code is {:code}, valid for 5 minutes
SMS_GHANA_CODE_TTL=300
SMS_GHANA_COOLDOWN_TTL=60
SMS_GHANA_WINDOW_TTL=300
SMS_GHANA_MAX_REQUESTS=5
SMS_GHANA_API_TRACE=true
# 生产关闭接口回传验证码；仅短信故障临时联调时可改 true
H5_OTP_RETURN_CODE=false
H5_OTP_DEV_CODE=888888
# 生产必须关闭通用验证码，仅接受短信验证码
H5_OTP_DEV_BYPASS_ENABLED=false

# 日志：logs/auto-draw/日期.log、logs/hubtel-payment-callback/日期.log、logs/h5/日期.log
# 资金表：transactions（流水）+ payment_records（支付）+ withdrawal_records（提现）
# H5 钱包 Hubtel 回跳（启用 2001 重试 initiate 时使用，当前未开启）
# HUBTEL_WALLET_RETURN_URL=https://m.luckygo.example/wallet/pay/return
# 迁移：sql/20260524_payment_and_withdrawal_records.sql
LOG_DIR=logs
LOG_TZ=Africa/Accra
TID_HEADER_NAME=X-Trace-Id

# Hubtel 正式环境充值（payproxyapi initiate + txnstatus + refund-api，与线上一致）
HUBTEL_MODE=production
HUBTEL_ACCOUNT_NUMBER=replace-before-use
HUBTEL_API_ID=replace-before-use
HUBTEL_API_KEY=replace-before-use
HUBTEL_CALLBACK_URL=https://your-api-host.example/api/payments/hubtel/callback
# HUBTEL_REFUND_CALLBACK_URL=https://api.luckygo.kwikcc.com/api/payments/hubtel/refund-callback

# 阿里云 OSS（图片上传）
OSS_ACCESS_ID=replace-before-use
OSS_ACCESS_SECRET=replace-before-use
OSS_BUCKET=replace-before-use
OSS_ENDPOINT=oss-cn-hongkong.aliyuncs.com
OSS_PUBLIC_URL=https://lucky-go.oss-cn-hongkong.aliyuncs.com
